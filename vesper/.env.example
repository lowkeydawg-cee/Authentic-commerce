# Public address of the store, used by the sitemap, robots file and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stock backend: "local" (browser storage, zero setup, for review and demos)
# or "supabase" (PostgreSQL + Realtime, live across every device; use for production).
NEXT_PUBLIC_INVENTORY_PROVIDER=local

# Required when NEXT_PUBLIC_INVENTORY_PROVIDER=supabase (Supabase → Project Settings → API).
# The anon key is public by design; Row Level Security in supabase/schema.sql protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
