# Data provider: "local" (browser storage, zero setup, great for demos)
# or "supabase" (PostgreSQL + realtime, recommended for production).
NEXT_PUBLIC_DATA_PROVIDER=local

# Required when NEXT_PUBLIC_DATA_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
